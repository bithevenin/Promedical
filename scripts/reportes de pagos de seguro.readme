-- Tabla para reportes de pagos enviados vs recibidos
CREATE TABLE reportes_pagos_seguro (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    seguro TEXT NOT NULL,
    mes TEXT NOT NULL, -- Formato YYYY-MM
    monto_enviado NUMERIC(15, 2) NOT NULL DEFAULT 0,
    monto_recibido NUMERIC(15, 2),
    fecha_envio DATE NOT NULL DEFAULT CURRENT_DATE,
    fecha_pago DATE,
    comentario TEXT,
    estado TEXT NOT NULL DEFAULT 'pendiente', -- 'pendiente' o 'completado'
    created_at TIMESTAMPTZ DEFAULT NOW()
);
-- Habilitar RLS (opcional, según tu configuración)
ALTER TABLE reportes_pagos_seguro ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Allow all for authenticated" ON reportes_pagos_seguro FOR ALL TO authenticated USING (true);