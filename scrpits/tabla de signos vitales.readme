-- La tabla de signos vitales
CREATE TABLE IF NOT EXISTS signos_vitales (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    paciente_cedula TEXT REFERENCES pacientes(cedula) ON DELETE CASCADE,
    fecha TIMESTAMPTZ DEFAULT NOW(),
    presion_arterial TEXT,
    frecuencia_cardiaca INTEGER,
    temperatura DECIMAL,
    peso DECIMAL,
    talla DECIMAL,
    imc DECIMAL
);

-- Habilitar RLS (Seguridad a nivel de fila)
ALTER TABLE signos_vitales ENABLE ROW LEVEL SECURITY;

-- Crear política para que todos puedan leer y escribir (ajuste según su necesidad de seguridad)
CREATE POLICY "Allow all for authenticated users" ON signos_vitales
    FOR ALL
    TO authenticated
    USING (true)
    WITH CHECK (true);