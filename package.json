{
  "name": "promedical",
  "version": "2.3.5",
  "author": "ProMedical System",
  "homepage": "https://ionicframework.com/",
  "main": "electron/main.cjs",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "server": "node server/server.cjs",
    "electron": "electron electron/main.cjs",
    "electron:dev": "electron electron/main.cjs --dev",
    "dev:local": "concurrently \"node server/server.cjs\" \"ng serve\"",
    "electron:build": "node scripts/make-icon.cjs && ng build --configuration production && npx electron-builder"
  },
  "build": {
    "electronVersion": "33.2.1",
    "appId": "com.promedical.clinic",
    "productName": "ProMedical",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "www/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/.bin/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "node_modules/sql.js/**/*",
      "node_modules/express/**/*",
      "node_modules/cors/**/*",
      "node_modules/ws/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "bithevenin",
      "repo": "Promedical"
    }
  },
  "private": true,
  "dependencies": {
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "sql.js": "^1.14.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular-eslint/builder": "^20.0.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/schematics": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@angular/animations": "^20.0.0",
    "@angular/cli": "20.3.15",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/language-service": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@angular/service-worker": "^20.0.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/cli": "8.0.0",
    "@capacitor/core": "8.0.0",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/status-bar": "8.0.0",
    "@ionic/angular": "^8.0.0",
    "@ionic/angular-toolkit": "^12.0.0",
    "@supabase/supabase-js": "^2.93.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^10.0.5",
    "dictionary-es": "^4.0.0",
    "electron": "33.2.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "ionicons": "^7.0.0",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nspell": "^2.1.5",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.9",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.25",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "description": "An Ionic project"
}
